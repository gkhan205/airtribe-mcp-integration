flowchart LR
    user(["Recruiter<br/>Streamlit / terminal chat"])
    subgraph AGENT["LangGraph agent  (matching_agent.py)"]
        direction TB
        parse_jd["parse_jd"]
        search["search_resumes<br/>(RAG index, local)"]
        deep["deep_analysis"]
        report["generate_report"]
        answer["answer_question<br/>(Claude picks tools)"]
        toolnode["tools (ToolNode)"]
    end
    client["MCPClient<br/>src/mcp_client/client.py<br/>JSON-RPC 2.0"]
    subgraph FS["filesystem_mcp_server.py"]
        direction TB
        fs_tools["Tools<br/>read_file · list_files · get_file_info<br/>search_in_file · write_file<br/>watch_directory · batch_process · server_status"]
